# Normalize line endings so gofmt / CI stay stable across platforms.
# Go sources and module files must stay LF; gofmt rejects CRLF.
* text=auto

*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf
justfile text eol=lf

# Docs and data keep natural handling
*.md   text
*.yaml text
*.json text

# Built-in mask prompt bytes are embedded and must stay LF-normalized.
internal/modules/masks/prompts/*.md text eol=lf

# Never touch binary fixtures
*.db   binary
*.bin  binary
