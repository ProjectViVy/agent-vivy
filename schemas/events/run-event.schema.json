{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/run-event.schema.json",
  "title": "RunEvent envelope",
  "description": "Vivy-owned contract for one durable journal event of a run (FR-5, D-017). Runtime, the JSON-RPC control plane, and the UI share this journal-backed event envelope. Payload shapes live in payloads/ keyed by type.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Run this event belongs to."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-run monotonic sequence number, starting at 1."
    },
    "type": {
      "type": "string",
      "enum": [
        "run.started",
        "provider.retry",
        "provider.stall",
        "model.reasoning_delta",
        "model.delta",
        "model.usage",
        "model.completed",
        "model.request",
        "tool.requested",
        "tool.approval_required",
        "tool.approval_decided",
        "tool.approval_expired",
        "tool.approval_cancelled",
        "tool.proposal_stale",
        "tool.started",
        "tool.finished",
        "tool.mounted",
        "policy.evaluated",
        "hook.started",
        "hook.completed",
        "hook.blocked",
        "user.question_required",
        "user.question_answered",
        "user.question_cancelled",
        "user.question_expired",
        "child.requested",
        "child.started",
        "child.suspended",
        "child.resumed",
        "child.completed",
        "child.failed",
        "child.cancelled",
        "context.compacted",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "channel.inbound"
      ],
      "description": "Event vocabulary, mirrors internal/domain EventTypes (B3)."
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix milliseconds."
    },
    "payload_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version of the payload shape; consumers reject unknown versions."
    },
    "payload": {
      "type": "object",
      "description": "Type-specific body; see payloads/<type>.json."
    }
  },
  "required": ["run_id", "seq", "type", "created_at", "payload_version", "payload"],
  "additionalProperties": false
}
