{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/run.cancelled.json",
  "title": "run.cancelled payload",
  "description": "Terminal event; exactly one terminal event per run (D-008). Emitted for user cancellation and for recovery-time definitive cancellation (AS-5, AS-6). Payload version is carried by the RunEvent envelope. V1 remains compatible; v2 adds the bounded Observer projection.",
  "oneOf": [
    {
      "title": "v1 legacy terminal",
      "type": "object",
      "properties": {
        "reason": { "type": "string", "enum": ["user_requested", "recovery"] }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    {
      "title": "v2 observer projection",
      "type": "object",
      "properties": {
        "reason": { "type": "string", "enum": ["user_requested", "recovery"] },
        "outcome": { "type": "string", "const": "cancelled" },
        "view": { "type": "string" },
        "tenant_id": { "type": "string" },
        "workspace_id": { "type": "string" },
        "session_id": { "type": "string" }
      },
      "required": ["reason", "outcome"],
      "additionalProperties": false
    }
  ]
}
