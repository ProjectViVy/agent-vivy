{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/run.started.json",
  "title": "run.started payload (v1)",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Active provider bundle name (openai | anthropic)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id the run was started with."
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "plan"
      ],
      "description": "Physical harness policy for this run."
    },
    "face": {
      "type": "string",
      "enum": [
        "web",
        "tui",
        "code",
        "headless"
      ],
      "description": "Entry assembly serving the run (web | tui | code | headless). Journals written before faces existed mean web."
    },
    "policy_profile": {
      "type": "string",
      "enum": [
        "default",
        "plan",
        "read_only",
        "full_auto"
      ],
      "description": "Immutable governance profile selected for this run."
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1,
      "description": "Digest of the policy definition used by the run."
    }
  },
  "required": [
    "provider",
    "model",
    "mode"
  ],
  "additionalProperties": false
}
