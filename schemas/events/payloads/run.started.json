{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/run.started.json",
  "title": "run.started payload (v1)",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Active provider bundle name (deepseek | openai | anthropic)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id the run was started with."
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "plan"
      ],
      "description": "Physical harness policy for this run."
    },
    "face": {
      "type": "string",
      "enum": [
        "web",
        "tui",
        "code",
        "headless"
      ],
      "description": "Entry assembly serving the run (web | tui | code | headless). Journals written before faces existed mean web."
    },
    "policy_profile": {
      "type": "string",
      "enum": [
        "default",
        "plan",
        "read_only",
        "full_auto"
      ],
      "description": "Immutable governance profile selected for this run."
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1,
      "description": "Digest of the policy definition used by the run."
    },
    "history_scope": {
      "type": "object",
      "description": "Host-resolved bounded history scope accepted at task admission; absent for legacy run.started events.",
      "properties": {
        "destination_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_session_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["destination_session_id", "source_session_ids", "scope_hash"],
      "additionalProperties": false
    }
  },
  "required": [
    "provider",
    "model",
    "mode"
  ],
  "additionalProperties": false
}
