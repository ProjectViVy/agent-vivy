{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/run.started.json",
  "title": "run.started payload (v1)",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Active provider bundle name (openai | anthropic | mock)."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id the run was started with."
    },
    "mode": {
      "type": "string",
      "enum": ["normal", "plan"],
      "description": "Physical harness policy for this run."
    }
  },
  "required": ["provider", "model", "mode"],
  "additionalProperties": false
}
