{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/model.call.finished.json",
  "title": "model.call.finished payload (v1)",
  "description": "Mandatory closure record of one observed model call (OBS-02/D2). Emitted exactly once per admitted call — normal EOF, setup/read error, downstream close, or cancellation — and exempt from the MaxEvents budget so no admitted call can end unclosed.",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identity shared with the call's v5 model.request and v2 model.usage samples."
    },
    "mode": {
      "type": "string",
      "enum": ["generate", "stream"]
    },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "enum": ["main", "child", "summary", "maintenance"]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "cancelled"]
    },
    "error": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "required": ["name", "message"],
      "additionalProperties": false,
      "description": "Present only for failed/cancelled finishes."
    },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": "integer", "minimum": 0 },
        "normalization_partial": { "type": "boolean" }
      },
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "additionalProperties": false,
      "description": "Last normalized provider-reported sample; absent when the provider reported no usage."
    },
    "response_complete": {
      "type": "boolean",
      "description": "True only when the model produced a complete response (normal stream EOF or Generate success)."
    },
    "wire": {
      "type": "object",
      "description": "Content-free description of the rejected HTTP request the provider actually received. Present only for a failed call whose transport observed a non-2xx response. Records shapes and identifiers, never message text.",
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "model": { "type": "string", "maxLength": 128 },
        "stream": { "type": "boolean" },
        "messages": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 128 }
        },
        "content_forms": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "enum": ["string", "array", "empty", "other"] }
        },
        "call_ids": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 128 }
        },
        "result_call_ids": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 128 }
        },
        "tool_count": { "type": "integer", "minimum": 0 },
        "tool_names": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 128 }
        },
        "tool_choice": { "type": "string", "maxLength": 128 },
        "extra_keys": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 128 }
        },
        "body_bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "truncated": { "type": "boolean" },
        "parse_error": { "type": "string", "maxLength": 128 }
      },
      "required": ["status", "stream", "messages", "tool_count", "body_bytes"],
      "additionalProperties": false
    }
  },
  "required": ["call_id", "mode", "provider", "model", "source", "status", "response_complete"],
  "additionalProperties": false
}
