{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/workflow.admitted.json",
  "title": "workflow.admitted payload (v1)",
  "description": "INOFY graph admission: the immutable program identity bound to this workflow run.",
  "type": "object",
  "properties": {
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "eino_build": {
      "type": "string"
    },
    "limits": {
      "type": "object"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "limits",
    "program_id"
  ],
  "additionalProperties": false
}
