{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/run.failed.json",
  "title": "run.failed payload",
  "description": "Terminal event; exactly one terminal event per run (D-008). Cause category is structured (FR-11) and never leaks internals. Payload version is carried by the RunEvent envelope. V1 remains compatible; v2 adds the bounded Observer projection.",
  "oneOf": [
    {
      "title": "v1 legacy terminal",
      "type": "object",
      "properties": {
        "cause_category": { "type": "string", "enum": ["provider_error", "tool_error", "internal_error", "cancelled", "human_timeout", "loop_detected"] },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["cause_category", "message"],
      "additionalProperties": false
    },
    {
      "title": "v2 observer projection",
      "type": "object",
      "properties": {
        "cause_category": { "type": "string", "enum": ["provider_error", "tool_error", "internal_error", "cancelled", "human_timeout", "loop_detected"] },
        "message": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "const": "failed" },
        "view": { "type": "string" },
        "tenant_id": { "type": "string" },
        "workspace_id": { "type": "string" },
        "session_id": { "type": "string" }
      },
      "required": ["cause_category", "message", "outcome"],
      "additionalProperties": false
    }
  ]
}
