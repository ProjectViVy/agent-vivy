{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vivy.local/schemas/events/payloads/tool.requested.json",
  "title": "tool.requested payload (v1)",
  "type": "object",
  "properties": {
    "tool_call_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "object",
      "description": "Tool arguments as requested by the model; shape fixed by the tool Spec."
    }
  },
  "required": ["tool_call_id", "tool_name", "args"],
  "additionalProperties": false
}
