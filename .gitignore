# Go build output
/vivy
/vivy.exe
/dist/
*.exe
*.test
*.out

# Local runtime data (SQLite db, checkpoints, logs) — never commit user data
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Local config with secrets — config.example.yaml is the committed template
/config.yaml
/config.local.yaml
.env
.env.*

# UI build artifacts and deps. ui/dist/.keep stays committed so go:embed
# compiles before the first Vite build.
/ui/node_modules/
/ui/dist/*
!/ui/dist/.keep

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
