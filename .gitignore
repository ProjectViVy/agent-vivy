# Go build output
/vivy
/vivy.exe
*.exe~
/dist/
*.exe
*.test
*.out

# Local runtime data (SQLite db, checkpoints, logs) — never commit user data
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Local config with secrets — config.example.yaml is the committed template
/config.yaml
/config.local.yaml
.env
.env.*

# Dependencies and build artifacts for any nested JS workspace
node_modules/

# UI build artifacts and deps. ui/dist is never committed (go:embed needs
# it, but pnpm emptyOutDir wipes a committed .keep on every build); fresh
# checkouts get it because `just ci` runs ui-ci before the Go-side vet.
/ui/dist/*
!/ui/dist/.keep

# Playwright e2e runtime outputs (generated workdir, reports, traces)
/ui/.e2e-workdir/
/.smoke-todo/
/ui/test-results/
/ui/playwright-report/
/test-results/

# Archived superseded artifacts (old spike/smoke binaries)
/archive/

# Local package-manager caches and transient packaging artifacts
/.pnpm-store/
meoo_zip_*.zip

# Local reference checkouts (deepseek-harness, eino, crush) — cloned on demand
/.workspace/

# Tool-generated repo knowledge cache (repowiki)
/.qoder/

# Local agent scratch (plans, transient state)
/.zcode/
/.worktrees/

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
