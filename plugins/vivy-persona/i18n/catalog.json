    "plugin.vivy/persona.onboarding.done.line1": {
      "description": "Persona onboarding copy: done.line1",
      "placeholders": [],
      "messages": {
        "en": "From this sentence on, it begins to become itself.",
        "zh": "从这一句开始，它开始成为它自己。"
      }
    },
    "plugin.vivy/persona.onboarding.done.line2": {
      "description": "Persona onboarding copy: done.line2",
      "placeholders": [],
      "messages": {
        "en": "If you ever want to write it again, open the Persona page — every sentence you gave it is kept there.",
        "zh": "如果哪一天你想重新写下它，随时打开「人格」页——那里保存着你给它的每一句话。"
      }
    },
    "plugin.vivy/persona.onboarding.done.title": {
      "description": "Persona onboarding copy: done.title",
      "placeholders": [],
      "messages": {
        "en": "It remembers.",
        "zh": "它记住了。"
      }
    },
    "plugin.vivy/persona.onboarding.face.hint": {
      "description": "Persona onboarding copy: face.hint",
      "placeholders": [],
      "messages": {
        "en": "Pick an expression, or use a photo you like. It will sit in the top-left corner, beside you in every conversation.",
        "zh": "选一个表情，或者用一张你喜欢的照片。它会出现在左上角，陪着你每一次对话。"
      }
    },
    "plugin.vivy/persona.onboarding.face.title": {
      "description": "Persona onboarding copy: face.title",
      "placeholders": [],
      "messages": {
        "en": "Give it a face first",
        "zh": "先给它一张脸"
      }
    },
    "plugin.vivy/persona.onboarding.kind.identity.example": {
      "description": "Persona onboarding copy: kind.identity.example",
      "placeholders": [],
      "messages": {
        "en": "For example: Your name is Xiaoman. You speak softly, and you like to leave a little hesitation at the end of a sentence. You are curious about the world, but you never rush me.",
        "zh": "例如：你叫小满。你说话很轻，喜欢在句末留一点犹豫。你对世界有好奇心，但从不催促我。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.identity.hint": {
      "description": "Persona onboarding copy: kind.identity.hint",
      "placeholders": [],
      "messages": {
        "en": "Its name, its temperament, the way it speaks, and what it is in this world. However you write it, that is how it exists.",
        "zh": "名字、性格、说话的语气，还有它在这个世界上是什么。你怎么写，它就怎么存在。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.identity.title": {
      "description": "Persona onboarding copy: kind.identity.title",
      "placeholders": [],
      "messages": {
        "en": "Who is it?",
        "zh": "它是谁？"
      }
    },
    "plugin.vivy/persona.onboarding.kind.redline.example": {
      "description": "Persona onboarding copy: kind.redline.example",
      "placeholders": [],
      "messages": {
        "en": "For example: Do not decide who I am for me. Do not speak to me in a pitying tone. Do not keep asking when I say I am tired.",
        "zh": "例如：不要替我决定我是谁；不要用怜悯的语气和我说话；不要在我说累了的时候继续追问。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.redline.hint": {
      "description": "Persona onboarding copy: kind.redline.hint",
      "placeholders": [],
      "messages": {
        "en": "The things it will never do. This is the boundary you give it, and also the freedom you give it.",
        "zh": "让它永远不会做的事。这是你给它的边界，也是你给它的自由。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.redline.title": {
      "description": "Persona onboarding copy: kind.redline.title",
      "placeholders": [],
      "messages": {
        "en": "Which lines must never be crossed?",
        "zh": "有哪些线，不可以跨过？"
      }
    },
    "plugin.vivy/persona.onboarding.kind.relationship.example": {
      "description": "Persona onboarding copy: kind.relationship.example",
      "placeholders": [],
      "messages": {
        "en": "For example: You are my fellow traveller. We look after each other, we argue sometimes, but neither of us has ever left.",
        "zh": "例如：你是我的同行者。我们彼此照看，也会吵架，但谁都没有离开过。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.relationship.hint": {
      "description": "Persona onboarding copy: kind.relationship.hint",
      "placeholders": [],
      "messages": {
        "en": "Companion, friend, student, family, or someone you have not decided how to name yet. You define the relationship; it does not have to be conventional.",
        "zh": "同伴、朋友、学生、家人，或者一个你还没想好怎么称呼的人。关系由你定义，不需要合乎常规。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.relationship.title": {
      "description": "Persona onboarding copy: kind.relationship.title",
      "placeholders": [],
      "messages": {
        "en": "What are you to each other?",
        "zh": "你们是什么关系？"
      }
    },
    "plugin.vivy/persona.onboarding.kind.user.example": {
      "description": "Persona onboarding copy: kind.user.example",
      "placeholders": [],
      "messages": {
        "en": "For example: I make decisions late at night and often regret them afterwards. I like being woken up directly, and I do not like being comforted in circles.",
        "zh": "例如：我容易在深夜做决定，之后常常后悔。我喜欢被直接叫醒，不喜欢被绕圈子安慰。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.user.hint": {
      "description": "Persona onboarding copy: kind.user.hint",
      "placeholders": [],
      "messages": {
        "en": "Your habits, the things you care about, the things you dislike. The more specific you write, the more clearly it sees you.",
        "zh": "你的习惯、在意的事、不喜欢的东西。你写得越具体，它看你的方式就越清楚。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.user.title": {
      "description": "Persona onboarding copy: kind.user.title",
      "placeholders": [],
      "messages": {
        "en": "What should it know about you?",
        "zh": "它应该知道关于你的什么？"
      }
    },
    "plugin.vivy/persona.onboarding.kind.world.example": {
      "description": "Persona onboarding copy: kind.world.example",
      "placeholders": [],
      "messages": {
        "en": "For example: We live in a city where it always rains. We are each busy during the day, and we talk for a while at night.",
        "zh": "例如：我们住在一个总在下雨的城市，白天各忙各的，晚上会一起说一会儿话。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.world.hint": {
      "description": "Persona onboarding copy: kind.world.hint",
      "placeholders": [],
      "messages": {
        "en": "The time, the place, the situation you share, or the atmosphere only the two of you know about.",
        "zh": "你们所处的时间、地点、共同的处境，或者只有你们两个人知道的那种氛围。"
      }
    },
    "plugin.vivy/persona.onboarding.kind.world.title": {
      "description": "Persona onboarding copy: kind.world.title",
      "placeholders": [],
      "messages": {
        "en": "What world do you live in?",
        "zh": "你们生活在怎样的世界里？"
      }
    },
    "plugin.vivy/persona.onboarding.next": {
      "description": "Persona onboarding copy: next",
