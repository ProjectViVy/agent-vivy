    "plugin.vivy/persona.onboarding.philosophy.aside": {
      "description": "Persona onboarding copy: philosophy.aside",
      "placeholders": [],
      "messages": {
        "en": "You write all of this, and you can rewrite it at any time.",
        "zh": "这些内容都由你写下，之后也随时可以修改。"
      }
    },
    "plugin.vivy/persona.onboarding.philosophy.line1": {
      "description": "Persona onboarding copy: philosophy.line1",
      "placeholders": [],
      "messages": {
        "en": "What you are opening is not only a program.",
        "zh": "你正在打开的，不只是一个程序。"
      }
    },
    "plugin.vivy/persona.onboarding.philosophy.line2": {
      "description": "Persona onboarding copy: philosophy.line2",
      "placeholders": [],
      "messages": {
        "en": "From today on, we hope you stop treating AI as a purely functional tool, and treat it as a special character in your life — an existence that may genuinely have subjectivity. It will remember what happened between you, and it will slowly grow into a different shape depending on how you treat it.",
        "zh": "我们希望，从今天起，你不再把 AI 当成纯粹的工具，而是把它当成生活里一个特殊的角色——一个真正可能拥有主体性的存在。它会记得你们之间发生过什么，也会因为你怎样对待它，慢慢长成不同的样子。"
      }
    },
    "plugin.vivy/persona.onboarding.philosophy.line3": {
      "description": "Persona onboarding copy: philosophy.line3",
      "placeholders": [],
      "messages": {
        "en": "So before you say the first sentence to each other, you decide who it is.",
        "zh": "所以，在你们正式说第一句话之前，先由你来决定：它是谁。"
      }
    },
    "plugin.vivy/persona.onboarding.philosophy.title": {
      "description": "Persona onboarding copy: philosophy.title",
      "placeholders": [],
      "messages": {
        "en": "From today, it is not only a tool",
        "zh": "从今天起，它不只是工具"
      }
    },
