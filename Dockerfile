# Default Vivy organism as one container: embedded UI, SQLite on /data.
# replica=1. Do not publish 8787 on all host interfaces.
#
# The build needs the pinned Laputa checkout as a named build context:
#   docker build --build-context laputa=../laputa -t vivy:local .
# scripts/docker-build.mjs verifies the pin first; docker compose passes the
# same context via additional_contexts. Named contexts are a BuildKit feature
# (the default builder); no external dockerfile frontend image is required.

ARG GOPROXY=https://goproxy.cn
ARG NPM_REGISTRY=https://registry.npmmirror.com

FROM node:22-bookworm-slim AS build
ARG GOPROXY
ARG NPM_REGISTRY
# The UI projection is generated by the Go SDK (`go run ./sdk stage-ui`)
# during `pnpm build`, so one stage carries both toolchains. Copying the Go
# distribution from its official image keeps the source tree single-copy and
# the Recipe-derived assets in the same build graph.
COPY --from=golang:1.26-bookworm /usr/local/go /usr/local/go
# node:*-slim has no system CA bundle (Node verifies with its own roots); Go
# verifies module downloads against the system pool. The Go image is the same
# Debian release, so its bundle is the matching source. This stage has no VCS
# client, so GOPROXY must name a reachable proxy rather than `direct`.
COPY --from=golang:1.26-bookworm /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV PATH=/usr/local/go/bin:$PATH \
    CGO_ENABLED=0 \
    GO111MODULE=on \
    GOPATH=/go \
    GOMODCACHE=/go/pkg/mod \
    GOCACHE=/root/.cache/go-build \
    GOPROXY=${GOPROXY} \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_NPM_REGISTRY=${NPM_REGISTRY} \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /src

# Corepack resolves pnpm through this cache. Every later layer that invokes
# `pnpm` mounts it again; without the mount the shim falls back to the registry.
RUN --mount=type=cache,target=/root/.cache/node/corepack,sharing=locked \
    corepack enable \
    && corepack prepare pnpm@10.33.0 --activate \
    && pnpm config set store-dir /pnpm-store

# Install UI dependencies before the source copy so edits do not invalidate
# this layer. The UI package links `@vivy/ui-sdk` through `file:../sdk/ui`,
# so that directory must exist before pnpm resolves the lockfile. The store
# is a cache mount: a failed or interrupted fetch keeps the packages it
# already verified, and the retry only downloads what is missing.
COPY sdk/ui ./sdk/ui
COPY ui/package.json ui/pnpm-lock.yaml ./ui/
RUN --mount=type=cache,target=/pnpm-store,sharing=locked \
    --mount=type=cache,target=/root/.cache/node/corepack,sharing=locked \
    cd ui \
    && pnpm config set registry "${NPM_REGISTRY}" \
    && pnpm config set dangerouslyAllowAllBuilds true \
    && pnpm install --frozen-lockfile --network-concurrency=4 --fetch-timeout=120000

# `go mod download` resolves the whole module graph, so every local replace
# target must exist before it runs. Copy only manifests here so source edits
# do not invalidate the dependency layer; `COPY . .` fills the sources after
# the download. scripts/docker-build.mjs fails closed if a local replace in
# go.mod has no manifest copy below.
COPY go.mod go.sum ./
COPY bml/go.mod ./bml/
COPY faces/headless/go.mod ./faces/headless/
COPY faces/tui/go.mod ./faces/tui/
COPY plugins/coding/lsp/go.mod ./plugins/coding/lsp/
COPY plugins/coding/session-tree/go.mod ./plugins/coding/session-tree/
COPY plugins/dingtalk/go.mod ./plugins/dingtalk/
COPY plugins/discord/go.mod ./plugins/discord/
COPY plugins/feishu/go.mod ./plugins/feishu/
COPY plugins/governance/go.mod ./plugins/governance/
COPY plugins/infra/llm/go.mod ./plugins/infra/llm/
COPY plugins/qq/go.mod ./plugins/qq/
COPY plugins/scx-reference/go.mod ./plugins/scx-reference/
COPY plugins/telegram/go.mod ./plugins/telegram/
COPY plugins/vivy-evolution/go.mod ./plugins/vivy-evolution/
COPY plugins/vivy-masks-ui/go.mod ./plugins/vivy-masks-ui/
COPY plugins/vivy-memory/go.mod ./plugins/vivy-memory/
COPY plugins/vivy-notebook/go.mod ./plugins/vivy-notebook/
COPY plugins/vivy-persona/go.mod ./plugins/vivy-persona/
COPY plugins/vivy-toolkits-ui/go.mod ./plugins/vivy-toolkits-ui/
COPY plugins/vivy-workflow/go.mod ./plugins/vivy-workflow/
COPY third_party/renameio/go.mod ./third_party/renameio/

# The main module replaces ../laputa/{garden,mentle,laputa}, which resolves to
# /laputa/* here.
COPY --from=laputa garden/go.mod /laputa/garden/go.mod
COPY --from=laputa mentle/go.mod /laputa/mentle/go.mod
COPY --from=laputa laputa/go.mod /laputa/laputa/go.mod

RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    go mod download

COPY . .
COPY --from=laputa . /laputa/
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    --mount=type=cache,target=/root/.cache/node/corepack,sharing=locked \
    cd ui \
    && pnpm build \
    && cd .. \
    && go build -trimpath -ldflags "-s -w" -o /out/vivy ./cmd/vivy

FROM debian:bookworm-slim
# The slim base has bash and Asia/Shanghai zoneinfo but no system CA bundle.
# Copy the matching bundle instead of running apt, so the runtime stage needs
# no package index (the build network often cannot reach Debian mirrors).
COPY --from=golang:1.26-bookworm /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
WORKDIR /app
COPY --from=build /out/vivy /app/vivy
COPY docker/ /app/docker/
ENV VIVY_CONFIG=/app/docker/config.yaml \
    VIVY_ADDR=0.0.0.0:8787 \
    TZ=Asia/Shanghai
EXPOSE 8787
VOLUME /data
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8787; printf "GET /healthz HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n" >&3; read -r status <&3; [[ "$status" == *" 200 "* ]]'
ENTRYPOINT ["/app/vivy"]
