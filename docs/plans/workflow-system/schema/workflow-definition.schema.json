{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vivy/workflow-definition@1",
  "title": "Vivy Workflow Definition v1",
  "description": "Normative schema for workflow definitions (issue #40, WF-1). Structural checks only; topology, capability, budget, and authority checks live in internal/workflow/validate.go.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "inputs": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/inputParam" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "outputs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/outputBinding" }
    }
  },
  "$defs": {
    "inputParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "boolean"] },
        "description": { "type": "string", "maxLength": 1000 },
        "required": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "config", "timeout_ms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "kind": { "enum": ["model", "agent", "io"] },
        "config": {},
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "model" } } },
          "then": { "properties": { "config": { "$ref": "#/$defs/modelConfig" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "agent" } } },
          "then": { "properties": { "config": { "$ref": "#/$defs/agentConfig" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "io" } } },
          "then": { "properties": { "config": { "$ref": "#/$defs/ioConfig" } } }
        }
      ]
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "user_template"],
      "properties": {
        "profile": { "type": "string", "minLength": 1, "maxLength": 200 },
        "system": { "type": "string", "maxLength": 16384 },
        "user_template": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
            "max_tokens": { "type": "integer", "minimum": 1, "maximum": 200000 }
          }
        }
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_template", "tools"],
      "properties": {
        "task_template": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^(readonly|[a-z0-9_]{1,64})$" }
        },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "ioConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template"],
      "properties": {
        "template": { "type": "string", "maxLength": 16384 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "to": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "template"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$" },
        "template": { "type": "string", "maxLength": 16384 }
      }
    }
  }
}
